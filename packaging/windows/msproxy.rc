/* Resources compiled into MSProxy.exe by windres.
 *
 * The icon is what Windows shows in Explorer, the taskbar and Alt-Tab; a
 * binary without one gets the generic placeholder, which on a machine
 * deployed by IT reads as something that should not be trusted.
 *
 * The version block is what the file's Properties dialog reads, and what
 * an inventory tool records — worth filling in for software that is pushed
 * to many machines. */

1 ICON "msproxy.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x4L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Simonetti"
      VALUE "FileDescription",  "MS Proxy"
      VALUE "FileVersion",      "v0.3.0-91-gc299b80-dirty"
      VALUE "InternalName",     "MSProxy"
      VALUE "OriginalFilename", "MSProxy.exe"
      VALUE "ProductName",      "MS Proxy"
      VALUE "ProductVersion",   "v0.3.0-91-gc299b80-dirty"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
